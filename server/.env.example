# Server (not 5000: macOS uses that port for AirPlay Receiver)
PORT=5001
NODE_ENV=development

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/atlibrary

# JWT - change this to a long random string
JWT_SECRET=at-library-2026

# Website address(es) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Borrowing rules
LOAN_DAYS=14
FINE_PER_DAY=10
MAX_ACTIVE_BORROWS=3

# The one admin (librarian) account, created by `npm run seed` (which also removes old sample data).
# Sign up only creates borrower accounts, so this is the only way to get an admin.
# Change these before seeding. Password: at least 8 characters with a letter and a number.
ADMIN_FIRST_NAME=Library
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@atlibrary.com
ADMIN_PASSWORD=admin1234@
